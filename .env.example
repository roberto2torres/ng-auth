# Google OAuth 2.0 Client ID (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=

# Backend base URL (Firebase Functions) for the /auth/* endpoints
NG_AUTH_API_URL=

# Route unauthenticated users are redirected to
NG_AUTH_LOGIN_ROUTE=/login

# Route users are redirected to after a successful login
NG_AUTH_DEFAULT_ROUTE=/
